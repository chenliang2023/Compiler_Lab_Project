const int INT_MAX = 2147483647;
const int INT_MIN = -2147483648;

int main() {
    int a = INT_MAX, b = 1, c = -1;
    int counter = 0;
    int result = 0;
    
    while (counter < 5) {
        // 算术溢出测试（加法）
        if (a + b > INT_MAX) {        // 触发溢出
            result = result - 10;
            c = c + 1;
        }
        
        // 乘法边界测试
        if (a * 2 <= INT_MIN) {       // 测试最大负值
            result = result / 2;     // 除零保护
        }
        
        // 安全除法处理
        if (c != 0) {                // 防除零保护
            if (result % c == 0) {   // 取模边界
                result = result + 1;
            } else if (result / c < -5) { // 负数除法截断
                result = result * 2;
            }
        }
        
        // 零值等式测试
        if (b * 0 == result) {       // 零比较
            result = result + 1;    // 改变结果状态
        }
        
        // 下溢测试
        if (a - b >= INT_MAX) {     // 下溢条件
            result = result - 100;
            a = INT_MIN / 2;        // 重置a值
        } else if (c * 3 <= INT_MIN + 5) { // 负边界
            result = result + 5;
        }
        
        // 循环控制
        if (counter * 4 > 7) {      // 条件表达式
            b = b - 2;
        } else {
            c = c + 3;
        }
        
        counter = counter + 1;      // 严格递增
    }
    
    // 最终边界验证
    if (result + INT_MAX == 0) {    // 溢出等式
        return (result % 7) + 1;    // 保证非零返回
    } else if (INT_MIN < result) {  // 极值比较
        return (result - INT_MIN) * 2;
    } else {
        return (INT_MAX / 2) + result;
    }
}